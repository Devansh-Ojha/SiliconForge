# Dockerfile for SiliconForge MicroVM Rootfs & Container Runner
# Contains complete open-source EDA toolchain: Verilator, Yosys, OpenROAD, cocotb, Icarus
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install base toolchain & compilers
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    llvm \
    git \
    make \
    cmake \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    bison \
    flex \
    libfl-dev \
    libreadline-dev \
    gawk \
    tcl-dev \
    graphviz \
    xdot \
    pkg-config \
    libboost-all-dev \
    zlib1g-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Verilator from source or package
RUN apt-get update && apt-get install -y --no-install-recommends \
    verilator \
    iverilog \
    yosys \
    && rm -rf /var/lib/apt/lists/*

# Install Python EDA verification packages
RUN pip3 install --no-cache-dir --break-system-packages \
    cocotb \
    pytest \
    rich \
    click

# Set up guest workspace
WORKDIR /workspace
CMD ["/bin/bash"]
